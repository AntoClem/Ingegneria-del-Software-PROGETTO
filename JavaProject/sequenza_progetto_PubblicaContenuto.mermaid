sequenceDiagram
    actor Docente
    participant F as :FormPubblicaContenuto
    participant C as :PubblicaContenutoController
    participant CO as :Corso
    participant CD as :ContenutoDAOH2Impl
    participant ID as :IscrizioneDAOH2Impl
    participant ND as :NotificaDAOH2Impl

    Docente->>+F: compila titolo, descrizione, categoria, sezione, statoPubblicazione, click Pubblica
    F->>F: verificaDatiPubblicazione(titolo, descrizione, categoria)

    alt dati validi
        F->>+C: pubblicaContenuto(corso, titolo, descrizione, categoria, sezione, pubblicaSubito)

        create participant CN as :Contenuto
        C->>CN: <<create>>(titolo, descrizione, categoria, corso, sezione, pubblicaSubito)
        C->>+CD: salva(contenuto)
        CD-->>-C: ok
        C->>CO: aggiungiContenuto(contenuto)

        opt pubblicaSubito è vero
            C->>+ID: cercaIscrittiPerCorso(corso)
            ID-->>-C: elencoStudenti

            create participant NT as :Notifica
            C->>NT: <<create>>(messaggio, studente, contenuto)
            C->>+ND: salva(notifica)
            ND-->>-C: ok
            note right of C: «include» InviaNotifica — la creazione e il salvataggio si ripetono per ciascuno studente presente in elencoStudenti
        end

        C-->>-F: contenutoPubblicato
        F-->>Docente: confermaPubblicazione
    else dati non validi
        F-->>Docente: erroreDatiObbligatori
    end

    deactivate F

    note over F,C: Rispetto al diagramma di analisi, il controllo sui campi obbligatori è ora eseguito nella Boundary: se fallisce, il Controller non viene nemmeno invocato.
